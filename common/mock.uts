// 分析报告文本（答辩时可直接展示）
const ANALYSIS_REPORT = '本轮共模拟 21 条群聊对话，覆盖任务发布、自我介绍、时间对齐、分工协商与分歧处理 5 个阶段。' +
	'系统重点关注三点：一是时间节奏是否可对齐，候选数字人「砺行」「清源」与你同在 21:00 后可响应；' +
	'二是角色是否互补，你的执行倾向与协调型、创意型数字人搭配更稳；三是互动质量，包括回应及时性、分歧处理方式与范围收敛能力。' +
	'综合三方面表现，推荐优先与「砺行」「清源」组队，邀请「牧野」以顾问形式参与方案评审。'

/**
 * 组装匹配结果
 * @param mode 采集模式
 * @param myName 本人数字人名称
 */
export function buildMatchResult(mode : string, myName : string) : MatchResult {
	const candidates : Candidate[] = []

	for (let i = 0; i < CAND_RAW.length; i++) {
		const row = CAND_RAW[i]
		const scores = splitBy(row[8], '|')
		const notes = splitBy(row[9], '|')

		const dims : DimScore[] = []
		for (let d = 0; d < DIM_NAMES.length; d++) {
			dims.push({
				key: DIM_KEYS[d],
				name: DIM_NAMES[d],
				weight: DIM_WEIGHTS[d],
				score: toInt(scores[d]),
				note: notes[d]
			})
		}

		const replay : ReplayLine[] = []
		const rawLines = splitBy(row[12], '|')
		for (let r = 0; r < rawLines.length; r++) {
			const parts = rawLines[r].split(':')
			const isMe = parts[0] == '1'
			const text = parts.length > 1 ? parts[1] : ''
			replay.push({
				isMe: isMe,
				name: isMe ? myName : row[0],
				avatar: isMe ? '我' : row[1],
				color: isMe ? '#2F7BFF' : row[2],
				text: text
			})
		}

		candidates.push({
			id: 'p' + (i + 1).toString(),
			name: row[0],
			avatar: row[1],
			color: row[2],
			role: row[3],
			title: row[4],
			score: toInt(row[5]),
			rank: i + 1,
			quote: row[6],
			sharedTime: row[7],
			dims: dims,
			highlights: splitBy(row[10], '|'),
			risks: splitBy(row[11], '|'),
			replay: replay
		})
	}

	const plan : TeamPlan = {
		title: '推荐组队方案',
		combo: [myName, '砺行', '清源'],
		reasons: [
			'砺行补上后端与接口交付，与你形成「执行 + 执行」的稳定输出组合',
			'清源负责范围收敛与风险跟踪，正好化解创意发散带来的进度风险',
			'三人的可用时间窗口在 21:00 后重合，集成联调成本最低'
		],
		risk: '创意类内容仍需外部支持，建议邀请牧野以顾问形式参与方案评审。'
	}

	return {
		myName: myName,
		candidateCount: candidates.length,
		analyzedMessages: SIM_RAW.length,
		teamPlan: plan,
		analysisReport: ANALYSIS_REPORT,
		candidates: candidates
	}
}

