/**
 * 组装模拟组队数据
 * @param mode 采集模式
 * @param dhName 本人数字人名称（用于替换群聊中「我」的发言）
 */
export function buildTeamSim(mode : string, dhName : string) : TeamSimData {
	const participants : Participant[] = [
		{ id: 'self', name: dhName, avatar: '我', color: '#2F7BFF', role: mode == 'deep' ? '深度建模数字人' : '快速建模数字人' },
		{ id: 'p1', name: '砺行', avatar: '砺', color: '#22D3EE', role: '执行者' },
		{ id: 'p2', name: '清源', avatar: '清', color: '#7C5CFF', role: '协调者' },
		{ id: 'p3', name: '牧野', avatar: '牧', color: '#34D399', role: '创意者' },
		{ id: 'p4', name: '溯光', avatar: '溯', color: '#FBBF24', role: '资料检索者' }
	]

	const messages : SimMessage[] = []
	for (let i = 0; i < SIM_RAW.length; i++) {
		const row = SIM_RAW[i]
		const isSelf = row[8] == '1'
		messages.push({
			id: 'm' + (i + 1).toString(),
			type: row[0],
			name: isSelf ? dhName + '（我）' : row[1],
			avatar: isSelf ? '我' : row[2],
			color: isSelf ? '#2F7BFF' : row[3],
			phase: row[4],
			text: row[5],
			delay: toInt(row[6]),
			highlight: row[7],
			isSelf: isSelf
		})
	}

	return {
		taskTitle: '分工讨论：48 小时做出可演示版本',
		taskText: '主持人数字人发起本轮协作：在 48 小时内产出一个可演示的版本，请各自说明能承担的分工与可用时间。',
		taskReqs: ['说明自己能承担的分工', '给出可稳定投入的时间段', '说明希望队友配合的方式'],
		participants: participants,
		messages: messages
	}
}

/* ============================================================
   四、量表提交返回假数据（对应接口 POST /api/save-scale）
   ============================================================ */

// 数字人名字池（根据采集模式确定性挑选，保证每次演示一致）
const DH_NAMES : string[] = ['辰星', '砺行', '清源', '牧野', '溯光']

/**
 * mock：提交量表后返回数字人 ID
 * 真实接口返回同样的字段结构
 */
export function buildScaleResult(mode : string) : ScaleResult {
	const index = mode == 'deep' ? 1 : 0
	const seq = index + 1
	const seqText = seq < 10 ? '00' + seq.toString() : (seq < 100 ? '0' + seq.toString() : seq.toString())
	return {
		dhId: 'DH-' + (mode == 'deep' ? 'DEEP' : 'QUICK') + '-' + seqText,
		dhName: DH_NAMES[index],
		mode: mode,
		createdAt: nowText()
	}
}

// 当前时间文本（yyyy-MM-dd hh:mm）
function nowText() : string {
	const d = new Date()
	const m = (d.getMonth() + 1) < 10 ? '0' + (d.getMonth() + 1).toString() : (d.getMonth() + 1).toString()
	const day = d.getDate() < 10 ? '0' + d.getDate().toString() : d.getDate().toString()
	const hh = d.getHours() < 10 ? '0' + d.getHours().toString() : d.getHours().toString()
	const mm = d.getMinutes() < 10 ? '0' + d.getMinutes().toString() : d.getMinutes().toString()
	return d.getFullYear().toString() + '-' + m + '-' + day + ' ' + hh + ':' + mm
}

/* ============================================================
   五、匹配结果假数据（对应接口 GET /api/get-result）
   ============================================================ */

// 维度名称与权重（五维打分）
const DIM_NAMES : string[] = ['人格兼容', '技能互补', '角色互补', '时间节奏', '互动质量']
const DIM_KEYS : string[] = ['personality', 'skill', 'role', 'time', 'interaction']
const DIM_WEIGHTS : number[] = [0.25, 0.2, 0.2, 0.15, 0.2]

// [名字, 头像, 颜色, 角色, 称号, 综合分, 代表发言, 共同时间, 五维分(90|95|..), 五维说明, 优势, 风险, 回放(0:文本|1:文本)]
const CAND_RAW : string[][] = [
	[
		'砺行', '砺', '#22D3EE', '执行者', '最佳拍档', '92',
		'范围必须在第一天定死，超出的部分放到二期。', '每日 21:00 - 23:00 同步', '90|95|93|88|94',
		'尽责性接近，都习惯提前交付|他补后端与接口，正好接住你的开发需求|执行者之间分工边界清晰|21:00 集成窗口完全重合|讨论中多次主动收敛范围，回应及时',
		'交付节奏稳定|接口文档规范|联调配合度高', '对需求范围控制相对严格',
		'0:我可以负责后端接口和数据结构，晚上 8 点后都能上线。|1:我希望接口文档提前一天定稿，方便我并行开发。|0:没问题，我今晚先把字段定稿发群里，明天中午前不再改。|1:那就好，我按这版文档并行开工。'
	],
	[
		'清源', '清', '#7C5CFF', '协调者', '稳定推进型', '87',
		'每次讨论后我出一版范围清单，第二天中午前发群里确认。', '中午 / 晚间各一次同步', '89|78|92|86|90',
		'宜人性高，冲突场景里会先降温|与你的技术技能重叠较少，但补上协调空缺|协调者与执行者是典型互补组合|固定会议与你晚间时间段兼容|主动把分歧写成风险清单，闭环意识强',
		'沟通闭环快|擅长化解分歧|记录与跟进稳定', '技术实现能力偏弱，需要你承担更多编码',
		'0:我把这次的范围分歧写进风险清单，明晚前给大家确认。|1:可以，我需要的是提前一天定稿。|0:好，我今晚先出一版，你只确认接口部分就行。|1:没问题，我明天中午前给你反馈。'
	],
	[
		'牧野', '牧', '#34D399', '创意者', '灵感补给型', '81',
		'第一天我先出一版最小范围，排不进二期的创意点就砍掉。', '晚间在线，白天异步', '76|84|85|74|82',
		'开放性都很高，但节奏偏好差异明显|创意与设计正好补上你的实现视角|创意者与执行者分工互补|白天响应不稳定，紧急联调有风险|配合意愿强，但需要有人收敛范围',
		'创意输出多|愿意被收敛范围|设计能力可用', '范围容易发散|白天响应不及时',
		'0:我想负责创新点和交互设计，先出一版方案草案。|1:可以，但范围需要第一天定死。|0:同意，我按最小范围来，多余的放二期。|1:那我们明晚确认范围清单。'
	],
	[
		'溯光', '溯', '#FBBF24', '资料检索者', '依据支撑型', '74',
		'我白天有课，只有晚上 9 点后能稳定投入。', '每日 21:00 之后', '72|70|78|66|80',
		'沟通偏内敛，需要主动追问才能拿到进度|技能互补度一般，与素材类需求匹配|角色上可以填补资料空缺|可用时间偏晚，白天基本失联|回应礼貌但频次偏低',
