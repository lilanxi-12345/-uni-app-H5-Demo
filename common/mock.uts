// 字符串转数组（用 | 分隔）
function splitBy(text : string, sep : string) : string[] {
	const arr : string[] = []
	const parts = text.split(sep)
	for (let i = 0; i < parts.length; i++) {
		if (parts[i] != '') {
			arr.push(parts[i])
		}
	}
	return arr
}

// 字符串转整数（只用最基础的字符串 API，避免不同平台之间的差异）
export function toInt(text : string) : number {
	let n = 0
	for (let i = 0; i < text.length; i++) {
		const code = text.charCodeAt(i)
		if (code >= 48 && code <= 57) {
			n = n * 10 + (code - 48)
		}
	}
	return n
}

// 选项文本 -> OptionItem[]
function toOptions(text : string) : OptionItem[] {
	const labels = splitBy(text, '|')
	const list : OptionItem[] = []
	for (let i = 0; i < labels.length; i++) {
		list.push({ value: i + 1, label: labels[i] })
	}
	return list
}

/**
 * 组装量表题目
 * 说明：量表题目属于前端静态内容，不走后端接口（后端只负责答案的接收与计算）。
 * @param mode quick 快速模式（TIPI-10 + 组队偏好 16 题）/ deep 深度模式（BFI-44 + 价值观 + 组队偏好 58 题）
 */
export function buildQuestions(mode : string) : Question[] {
	const list : Question[] = []
	const isDeep = mode == 'deep'

	if (isDeep) {
		for (let i = 0; i < BFI_RAW.length; i++) {
			const row = BFI_RAW[i]
			list.push({
				id: 'B' + (i + 1).toString(),
				section: '人格量表（BFI-44）',
				type: 'scale',
				text: row[0],
				dim: row[1],
				reverse: row[2] == '1',
				field: '',
				options: SCALE_OPTIONS
			})
		}
		for (let i = 0; i < VALUES_RAW.length; i++) {
			list.push({
				id: 'V' + (i + 1).toString(),
				section: '价值观题目',
				type: 'scale',
				text: VALUES_RAW[i],
				dim: 'V',
				reverse: false,
				field: '',
				options: SCALE_OPTIONS
			})
		}
		for (let i = 0; i < PREF_RAW.length; i++) {
			const row = PREF_RAW[i]
			list.push({
				id: row[0],
				section: '组队偏好与底线',
				type: 'choice',
				text: row[2],
				dim: '',
				reverse: false,
				field: row[1],
				options: toOptions(row[3])
			})
		}
	} else {
		for (let i = 0; i < TIPI_RAW.length; i++) {
			const row = TIPI_RAW[i]
			list.push({
				id: 'T' + (i + 1).toString(),
				section: '人格量表（TIPI-10）',
				type: 'scale',
				text: row[0],
				dim: row[1],
				reverse: row[2] == '1',
				field: '',
				options: SCALE_OPTIONS
			})
		}
		for (let i = 0; i < PREF_RAW.length; i++) {
			const row = PREF_RAW[i]
			list.push({
				id: row[0],
				section: '组队偏好',
				type: 'choice',
				text: row[2],
				dim: '',
				reverse: false,
				field: row[1],
				options: toOptions(row[3])
			})
		}
	}
	return list
}

