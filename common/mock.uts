/**
 * 组装对话采集轮次（前端静态内容，采集到的记录才需要保存到后端）
 */
export function buildDialogRounds(mode : string) : DialogRound[] {
	const raw = mode == 'deep' ? DIALOG_DEEP_RAW : DIALOG_QUICK_RAW
	const list : DialogRound[] = []
	for (let i = 0; i < raw.length; i++) {
		list.push({ scene: raw[i][0], ai: raw[i][1], sample: raw[i][2] })
	}
	return list
}

