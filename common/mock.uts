]

// 活动分类筛选项
export const ACTIVITY_CATEGORIES : string[] = ['全部', '竞赛类', '双创类']

/**
 * 组装竞赛活动列表（前端静态内容；后端如需动态活动可另行提供接口）
 */
export function buildActivities() : ActivityItem[] {
	const list : ActivityItem[] = []
	for (let i = 0; i < ACTIVITY_RAW.length; i++) {
		const row = ACTIVITY_RAW[i]
		list.push({
			id: row[0],
			name: row[1],
			organizer: row[2],
			level: row[3],
			teamSize: row[4],
			deadline: row[5],
			duration: row[6],
			status: row[7],
			desc: row[8],
			reward: row[9],
			needRoles: splitBy(row[10], '|')
		})
	}
	return list
}

/* ============================================================
   七、数字人档案（8 字段画像，前端本地生成）
   说明：真实版本可由后端 /api/save-scale 或独立接口返回同结构数据
   ============================================================ */

/**
 * 组装数字人档案
 * @param mode 采集模式
 * @param dhName 数字人名称（来自量表提交返回）
 * @param sampleCount 对话采集到的样本条数
 */
export function buildProfile(mode : string, dhName : string, sampleCount : number, skillsText : string) : DigitalProfile {
	const isDeep = mode == 'deep'

	const bigFive : BigFiveItem[] = [
		{ name: '外向性', score: isDeep ? 62 : 58, desc: '主动表达、带动团队气氛的程度' },
		{ name: '尽责性', score: isDeep ? 86 : 78, desc: '守时、靠谱、把事情做到底的程度' },
		{ name: '宜人性', score: isDeep ? 74 : 70, desc: '体谅他人、愿意让步与配合的程度' },
		{ name: '情绪稳定性', score: isDeep ? 68 : 64, desc: '压力下保持冷静、情绪不易波动的程度' },
		{ name: '开放性', score: isDeep ? 80 : 72, desc: '接受新方案、愿意尝试不同做法' }
	]

	// 技能标签：优先使用用户在「技能标签」页勾选的结果，未勾选时给一份默认值
	const skills : SkillItem[] = []
	const skillTags = splitBy(skillsText, '|')
	for (let i = 0; i < skillTags.length; i++) {
		skills.push({ name: skillTags[i], level: 70 + (i * 7) % 26 })
	}
	if (skills.length == 0) {
		skills.push({ name: 'Python / FastAPI', level: 86 })
		skills.push({ name: '数据分析与建模', level: 78 })
	}

	const redlines : string[] = ['临时摆烂、长期不回复消息', '临近截止才反馈真实进度']

	const speechSamples : string[] = [
		'同步一下进度：我这边接口还有个问题没解决，预计今晚十点前能定位原因。',
		'我理解你想用这个方案，不过我担心时间不够兜底，先验证一个最小 demo 吧。'
	]
	if (sampleCount > 0) {
		speechSamples.push('本次对话采集共记录 ' + sampleCount.toString() + ' 段表达，已用于建模。')
	}

	const memoryAnchors : string[] = [
		'数学建模比赛负责数据处理与模型部分',
		'习惯在关键节点主动同步进展'
	]

	return {
		dhId: 'DH-' + (isDeep ? 'DEEP' : 'QUICK'),
		dhName: dhName,
		avatar: isDeep ? '清' : '辰',
		modeName: isDeep ? '深度建模' : '快速建模',
		completeness: isDeep ? 94 : 82,
		oneLine: '一个简洁直接的执行者，习惯在关键节点主动同步进展。',
		tags: ['#执行者', '#简洁直接', '#时间可控', '#Python'],
		bigFive: bigFive,
		role: '执行者 + 协调者',
		roleDesc: '把分到的事情做扎实，也愿意主动对齐团队进度。',
		commStyle: '简洁直接',
		commPace: '随时同步关键进展',
		commConflict: '先听完再表达看法',
		weekdays: '工作日 20:00 - 23:00',
		weekend: '周末弹性参与',
		hours: '约 12 小时 / 周',
		skills: skills,
		redlines: redlines,
		speechSamples: speechSamples,
		memoryAnchors: memoryAnchors
	}
}

